{
  "name": "finanzas-app",
  "version": "1.0.0",
  "description": "Control de finanzas personales - BRL y Oro",
  "scripts": {
    "dev": "live-server . --port=3000 --wait=200",
    "start": "live-server . --port=3000 --no-browser",
    "serve": "live-server . --port=3000 --no-browser",
    "cap:sync": "npx cap sync android",
    "apk": "npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "live-server": "^1.2.2"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2"
  }
}
